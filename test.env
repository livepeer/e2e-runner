# Loaded by go test. Existing process environment values take precedence.
# Configure these for an explicitly selected disposable chain:
# E2E_RPC_URL=
# E2E_ETH_CONTROLLER=
# E2E_EXPECTED_CHAIN_ID=
E2E_ORCHESTRATORS=go-livepeer,node
E2E_SIGNERS=go-livepeer,node
E2E_TEST_TIMEOUT=90m
E2E_HTTP_TIMEOUT=5s
E2E_JOB_TIMEOUT=30s
E2E_MEDIA_TIMEOUT=40s
E2E_DISCOVERY_TIMEOUT=30s
E2E_LIVE_EXHAUSTION_TIMEOUT=20s
E2E_REDEMPTION_TIMEOUT=90s
E2E_BLOCK_TIMEOUT=3m
E2E_ORACLE_TIMEOUT=90s
E2E_ORACLE_POLL_INTERVAL=1h
E2E_ORACLE_MAX_AGE=2h
E2E_ORACLE_TEST_MAX_AGE=45s
E2E_GO_BASE_PRICE_WEI=1
E2E_READY_TIMEOUT=30s
E2E_RPC_TIMEOUT=10s
E2E_TRANSACTION_TIMEOUT=45s
E2E_CLI_TIMEOUT=2m
E2E_AUTO_FAUCET=true
E2E_FAUCET_TIMEOUT=45m
E2E_FAUCET_MAX_REQUESTS=500
E2E_ACTIVATION_TIMEOUT=3m
E2E_BUILD_TIMEOUT=3m
E2E_WEI_PER_USD=1000000000000000
E2E_ETH_USD=1000
E2E_SIGNER_MAX_HOURLY_USD=100
E2E_SIGNER_MAX_FIXED_USD=1
E2E_GO_SIGNER_MAX_PRICE_WEI=1000000000000000
E2E_ACCOUNT_ETH=1
E2E_PAYER_DEPOSIT_ETH=0.1
E2E_PAYER_RESERVE_ETH=0.1
E2E_BOND_LPT=1000
E2E_BOND_MARGIN_LPT=1000
E2E_TICKET_FACE_VALUE=400000000000
E2E_TICKET_EV=200000000000
E2E_TICKET_WIN_PROB=57896044618658097711785492504343953926634992332820282019728792003956564819967
E2E_ACCOUNTING_TIMEOUT=20s
E2E_KAFKA_TOPIC=livepeer-signing
E2E_OUTBOX_MAX_BYTES=268435456
E2E_CHAIN_CONFIRMATIONS=2
E2E_CHAIN_POLL_INTERVAL=200ms
# Set source checkout paths for the implementations under test:
# GO_LIVEPEER_DIR=
# E2E_NODE_DIR=
# E2E_CLEARINGHOUSE_DIR=
# PYTHON_RUNNER_DIR=
# Optional prebuilt binaries: LIVEPEER_BINARY, E2E_GO_LIVEPEER_CLI_BINARY,
# E2E_NODE_BINARY, E2E_CLEARINGHOUSE_BINARY.
# Optional toolchain/feed overrides: E2E_GO_BINARY, E2E_PRICE_FEED_ADDRESS.
# Funding uses the first unlocked account with enough ETH/LPT, or specify
# E2E_FUNDER_ADDRESS and/or E2E_LPT_FUNDER_ADDRESS. Signed funding:
# E2E_FUNDER_KEY_FILE=/absolute/path/to/disposable-devnet-private-key

# Credential references and artifact output (never put private keys here):
# E2E_BOOTSTRAP_SECRET_FILE=/absolute/path/to/owner-only/bootstrap-secret
# E2E_ARTIFACT_DIR=/absolute/path/to/test-results
# E2E_GOLANG_RUNNER_DIR=/absolute/path/to/golang-runner (Make launcher override)

# Compose uses a fresh go-livepeer devnet and ignores external chain/funder settings.
# Requires a Linux Docker host; use test-compose-gcp from macOS.
# E2E_LPMS_DIR=/absolute/path/to/lpms (for a local go-livepeer module replacement)
# E2E_RUNTIME_IMAGE=e2e-scope-runtime:local
# E2E_GETH_IMAGE=livepeer/geth-with-livepeer-protocol:confluence
# E2E_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.1
# E2E_GCP_PROJECT=your-project (defaults to gcloud's configured project)
# E2E_GCP_ZONE=us-west1-b
# E2E_GCP_MACHINE_TYPE=e2-standard-8
